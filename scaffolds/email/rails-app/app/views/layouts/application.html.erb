<!DOCTYPE html>
<html>
  <head>
    <title>Team Tasks</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
  </head>
  <body>
    <header>
      <%= link_to "Team Tasks", root_path %>
      <% if current_user %>
        <%= current_user.name %> <%= button_to "Sign out", logout_path, method: :delete %>
      <% end %>
    </header>
    <% if flash[:alert] %><p><%= flash[:alert] %></p><% end %>
    <main><%= yield %></main>
  </body>
</html>
