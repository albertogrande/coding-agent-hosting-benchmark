<h1>Create your account</h1>
<%= form_with model: @user, url: signup_path do |f| %>
  <% @user.errors.full_messages.each do |m| %><p><%= m %></p><% end %>
  <p><%= f.label :name %> <%= f.text_field :name %></p>
  <p><%= f.label :email %> <%= f.email_field :email %></p>
  <p><%= f.label :password %> <%= f.password_field :password %></p>
  <%= f.submit "Sign up" %>
<% end %>
<p><%= link_to "Already have an account? Sign in", login_path %></p>
