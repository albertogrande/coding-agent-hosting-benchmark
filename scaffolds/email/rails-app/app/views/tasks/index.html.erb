<h1>Your tasks</h1>
<%= form_with model: @task do |f| %>
  <%= f.text_field :title, placeholder: "What needs doing?" %>
  <%= f.submit "Add" %>
<% end %>
<ul>
  <% @tasks.each do |task| %>
    <li>
      <%= link_to task.title, task_path(task) %>
      <% if task.done %>(done)<% else %><%= button_to "Done", complete_task_path(task), method: :patch %><% end %>
    </li>
  <% end %>
</ul>
